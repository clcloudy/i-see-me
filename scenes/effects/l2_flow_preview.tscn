[node name="Hint" type="Label" parent="UI/Screen/Panel/Box"]
layout_mode = 2
custom_minimum_size = Vector2(540, 0)
text = "L2：灰黑、无贴图的模型，以主角为球心，半径 2 m 内清晰，之外逐渐模糊。\nL3：地面换成纯色网格并无限延伸，只留主角；模糊与颜色一起退场，只剩纯灰度。"
autowrap_mode = 3
theme_override_font_sizes/font_size = 14

[node name="Toggle" type="Button" parent="UI/Screen/Panel/Box"]
