# Normalize text in Git and in working copies across operating systems.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets untouched.
*.png binary
*.exr binary
*.hdr binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.glb binary
*.blend binary
*.fbx binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.zip binary
*.exe binary
*.pck binary
